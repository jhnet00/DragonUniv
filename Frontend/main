let displayedCourses = [...COURSES];
let cart = [];
let myRegistered = [];
let dragSrcIdx = null;
 
// ── RENDER COURSES ──
function getBadgeClass(type){
  if(type.includes('필수')) return 'badge-required';
  if(type.includes('선택')) return type.includes('전공') ? 'badge-major' : 'badge-elective';
  if(type.includes('스탐')) return 'badge-stamp';
  return 'badge-elective';
}
 
function renderCourses(list){
  const tb = document.getElementById('course-tbody');
  document.getElementById('result-count').textContent = list.length;
  if(list.length === 0){
    tb.innerHTML = `<tr><td colspan="13"><div class="empty-state"><div class="empty-icon">🔍</div><p>검색 결과가 없습니다.<br>검색 조건을 변경해 보세요.</p></div></td></tr>`;
    return;
  }
  tb.innerHTML = list.map(c => {
    const inCart = cart.some(x => x.id === c.id);
    const full = c.enrolled >= c.cap;
    return `<tr>
      <td>${inCart
        ? '<span style="font-size:11px;color:var(--success);font-weight:700">✓ 추가됨</span>'
        : `<button class="btn-add" onclick="addCart(${c.id})" ${full?'style="background:#aaa;cursor:not-allowed"':''} ${full?'disabled':''}>
            ${full ? '마감' : '관심등록'}
          </button>`
      }</td>
      <td style="color:var(--gray-500)">${c.code}</td>
      <td class="name-cell" style="padding-left:14px">${c.name}</td>
      <td>${c.grade === 99 ? '전학년' : c.grade + '학년'}</td>
      <td><span class="badge ${getBadgeClass(c.type)}">${c.type}</span></td>
      <td><strong>${c.credit}</strong></td>
      <td>${c.theory}/${c.practice}</td>
      <td><span class="badge badge-day">${c.cat}</span></td>
      <td>${c.sec}</td>
      <td>${c.prof}</td>
      <td>
        <div class="cap-bar">
          <span class="filled">${c.enrolled}</span>
          <span class="total">/ ${c.cap}</span>
        </div>
      </td>
      <td style="color:var(--gray-500)">${c.wish}</td>
      <td style="font-size:11px;color:var(--gray-600)">${c.time}</td>
    </tr>`;
  }).join('');
}
 
// ── RENDER CART ──
function renderCart(){
  const tb = document.getElementById('cart-tbody');
  const totalCredit = cart.reduce((s,c) => s + c.credit, 0);
  document.getElementById('cart-credit').textContent = totalCredit;
  document.getElementById('cart-cnt').textContent = cart.length;
  document.getElementById('cart-credit-foot').textContent = totalCredit;
  document.getElementById('cart-cnt-foot').textContent = cart.length;
 
  if(cart.length === 0){
    tb.innerHTML = `<tr><td colspan="15"><div class="empty-state"><div class="empty-icon">🔖</div><p>관심과목이 없습니다.<br>위 목록에서 <strong>관심등록</strong> 버튼을 클릭해 추가하세요.</p></div></td></tr>`;
    return;
  }
 
  tb.innerHTML = cart.map((c, i) => `
    <tr draggable="true"
        ondragstart="dragStart(event,${i})"
        ondragover="dragOver(event)"
        ondrop="drop(event,${i})"
        ondragleave="dragLeave(event)"
        id="cart-row-${i}">
      <td><span class="drag-handle" title="드래그로 순서 변경">⠿</span></td>
      <td style="color:var(--gray-500)">${c.code}</td>
      <td class="name-cell" style="padding-left:14px">${c.name}</td>
      <td>${c.grade === 99 ? '전학년' : c.grade + '학년'}</td>
      <td><span class="badge ${getBadgeClass(c.type)}">${c.type}</span></td>
      <td><strong>${c.credit}</strong></td>
      <td>${c.theory}/${c.practice}</td>
      <td><span class="badge badge-day">${c.cat}</span></td>
      <td>${c.sec}</td>
      <td>${c.prof}</td>
      <td>
        <div class="cap-bar">
          <span class="filled">${c.enrolled}</span>
          <span class="total">/ ${c.cap}</span>
        </div>
      </td>
      <td style="color:var(--gray-500)">${c.wish}</td>
      <td style="font-size:11px;color:var(--gray-600)">${c.time}</td>
      <td style="font-size:10px;color:var(--gray-500)">교양/소통</td>
      <td><button class="btn-del" onclick="removeCart(${i})">삭제</button></td>
    </tr>`).join('');
}
 
// ── RENDER MY PAGE ──
function renderMyPage(){
  const tb = document.getElementById('my-tbody');
  const total = myRegistered.reduce((s,c) => s + c.credit, 0);
  document.getElementById('my-cnt').innerHTML = myRegistered.length + ' <span>과목</span>';
  document.getElementById('my-credit').innerHTML = total + ' <span>학점</span>';
  document.getElementById('my-remain').innerHTML = (21 - total) + ' <span>학점</span>';
 
  if(myRegistered.length === 0){
    tb.innerHTML = `<tr><td colspan="9"><div class="empty-state"><div class="empty-icon">📋</div><p>수강신청이 완료된 과목이 없습니다.<br>관심과목 목록에서 최종 수강신청을 진행해주세요.</p></div></td></tr>`;
    return;
  }
  tb.innerHTML = myRegistered.map((c,i) => `
    <tr>
      <td>${i+1}</td>
      <td>${c.code}</td>
      <td class="name-cell" style="padding-left:14px">${c.name}</td>
      <td>${c.grade===99?'전학년':c.grade+'학년'}</td>
      <td><span class="badge ${getBadgeClass(c.type)}">${c.type}</span></td>
      <td><strong>${c.credit}</strong></td>
      <td>${c.prof}</td>
      <td style="font-size:11px">${c.time}</td>
      <td><span class="badge" style="background:#e8f5e9;color:#2e7d32;border:1px solid #a5d6a7">신청완료</span></td>
    </tr>`).join('');
}
 
// ── CART ACTIONS ──
function addCart(id){
  const c = COURSES.find(x => x.id === id);
  if(!c) return;
  if(cart.some(x => x.id === c.id)){
    showToast('이미 관심과목에 추가된 강좌입니다.', 'error'); return;
  }
  const totalCredit = cart.reduce((s,x) => s + x.credit, 0);
  if(totalCredit + c.credit > 21){
    showToast('최대 신청 가능 학점(21학점)을 초과합니다.', 'error'); return;
  }
  cart.push({...c});
  renderCart();
  renderCourses(displayedCourses);
  showToast(`[${c.name}] 관심과목에 추가되었습니다.`, 'success');
}
 
function removeCart(idx){
  const name = cart[idx].name;
  cart.splice(idx, 1);
  renderCart();
  renderCourses(displayedCourses);
  showToast(`[${name}] 관심과목에서 삭제되었습니다.`);
}
 
// ── DRAG & DROP ──
function dragStart(e, i){ dragSrcIdx = i; e.dataTransfer.effectAllowed = 'move'; }
function dragOver(e){ e.preventDefault(); e.currentTarget.classList.add('drag-over'); return false; }
function dragLeave(e){ e.currentTarget.classList.remove('drag-over'); }
function drop(e, i){
  e.preventDefault();
  e.currentTarget.classList.remove('drag-over');
  if(dragSrcIdx === null || dragSrcIdx === i) return;
  const item = cart.splice(dragSrcIdx, 1)[0];
  cart.splice(i, 0, item);
  dragSrcIdx = null;
  renderCart();
}
 
// ── SEARCH ──
function doSearch(){
  const dept = document.getElementById('f-dept').value;
  const grade = document.getElementById('f-grade').value;
  const day = document.getElementById('f-day').value;
  const kw = document.getElementById('f-keyword').value.trim().toLowerCase();
 
  displayedCourses = COURSES.filter(c => {
    if(dept && c.dept !== dept) return false;
    if(grade && c.grade !== parseInt(grade)) return false;
    if(day && !c.days.includes(day)) return false;
    if(kw && !c.name.toLowerCase().includes(kw) && !c.code.includes(kw) && !c.prof.includes(kw)) return false;
    return true;
  });
  renderCourses(displayedCourses);
}
 
function doReset(){
  document.getElementById('f-dept').value = '';
  document.getElementById('f-grade').value = '';
  document.getElementById('f-day').value = '';
  document.getElementById('f-keyword').value = '';
  displayedCourses = [...COURSES];
  renderCourses(displayedCourses);
}
 
function filterByType(val){ doSearch(); }
 
// ── ORDER SAVE ──
function saveOrder(){
  if(cart.length === 0){ showToast('관심과목이 없습니다.', 'error'); return; }
  showToast('순서가 저장되었습니다. (' + cart.map(c=>c.name.substring(0,6)).join(', ') + ')', 'success');
}
 
// ── TAB SWITCH ──
function switchTab(tab){
  document.getElementById('tab-search').style.display = tab === 'search' ? '' : 'none';
  document.getElementById('tab-my').style.display = tab === 'my' ? '' : 'none';
  document.getElementById('tab-btn-search').classList.toggle('active', tab === 'search');
  document.getElementById('tab-btn-my').classList.toggle('active', tab === 'my');
  if(tab === 'my') renderMyPage();
}
 
// ── TOAST ──
let toastTimer;
function showToast(msg, type=''){
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = 'toast show' + (type ? ' ' + type : '');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), 2500);
}
 
// ── INIT ──
renderCourses(COURSES);
renderCart();
</script>
